{
  // yoinked from https://github.com/rubyowo/dotfiles/blob/f925cf8e3461420a21b6dc8b8ad1190107b0cc56/config/waybar/config
  "layer": "top", // Waybar at top layer
  "position": "bottom", // Waybar position (top|bottom|left|right)
  "modules-left": [],
  "modules-center": [],
  "modules-right": ["pulseaudio", "clock", "tray", "custom/lock", "custom/power"],
  "tray": {
    "icon-size": 21,
    "spacing": 10
  },
  "clock": {
    "timezone": "America/New_York",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": " {:%d/%m/%Y}",
    "format": "   {:%H:%M}"
  },
  "pulseaudio": {
    "scroll-step": 5, // %, can be a float
    "format": "{icon}   {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "pavucontrol"
  },
  "custom/lock": {
    "tooltip": false,
    "on-click": "sh -c '(sleep 0.5s; hyprlock)' & disown",
    "format": "",
  },
  "custom/power": {
    "tooltip": false,
    "on-click": "wlogout &",
    "format": "󰍃"
  },
  // "niri/window": {
  //   "format": "{}",
  //   "rewrite": {
  //     "(.*) - Mozilla Firefox": "🌎 $1",
  //     "(.*) - zsh": "> [$1]"
  //   }
  // }
}
